# Environment
ENV=development
PORT=3000

# Database
# PostgreSQL connection string
# Development: Use node-postgres (pg). The default below matches docker-compose.yml.
# Production: Use Neon serverless
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brews

# Authentication
# Any string works for local development. For anything deployed, generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Admin (OPTIONAL - set to admin@test.com to open /admin with the seeded admin account)
# ADMIN_USER_EMAIL=

# Discord OAuth (OPTIONAL - social login hidden when not configured)
# Get credentials from: https://discord.com/developers/applications
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Google OAuth (OPTIONAL - social login hidden when not configured)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (OPTIONAL - emails logged to console when not configured)
# Get API key from: https://resend.com/api-keys
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# BROADCAST_SECRET=

# Test User (OPTIONAL - used by E2E test setup)
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=password123
